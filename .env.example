# ========================================================
# EVENTFLOW — CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ========================================================

# 1. PLATAFORMA & API
# AI Studio injeta automaticamente em tempo de execução
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# 2. FRONTEND (Vite - Apenas variáveis públicas)
# AVISO: Todas as variáveis com prefixo VITE_ são embutidas no pacote JavaScript público.
# NUNCA coloque chaves secretas ou de serviço aqui!
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publica-anon"

# 3. BACKEND PRIVADO (Node.js / Express - Exclusivo do servidor)
# Estas variáveis NUNCA são expostas ao navegador ou ao bundle de frontend.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SECRET_KEY="sua-chave-secreta-service-role-privada"
SUPABASE_JWKS_URL="https://seu-projeto.supabase.co/auth/v1/.well-known/jwks.json"
